# --- Frontend environment variables ---
# Copy to frontend/.env(.local) for local dev, or set in your host's build env.
# Only VITE_-prefixed vars are exposed to the browser bundle.

# Base URL of the backend API (no trailing slash).
# Local dev default (when unset): http://localhost:5000
# Production example: https://your-backend.example.com
VITE_API_BASE_URL=http://localhost:
