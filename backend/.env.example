# --- Backend environment variables ---
# Copy to backend/.env and fill in real values. Never commit the real .env.

# Runtime mode. Use "production" when deploying — it suppresses internal error
# detail in API responses. Defaults to "development".
NODE_ENV=development

# Port the HTTP server listens on. Defaults to 5000. Many hosts inject this.
PORT=5000

# MongoDB Atlas connection string (mongodb+srv://...). Required.
MONGODB_URI=your-mongodb-atlas-connection-string

# Secret used to sign JWTs. Use a long random string. Required.
JWT_SECRET=your-long-random-secret

# JWT lifetime (zeit/ms format, e.g. "7d", "12h"). Defaults to "7d".
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed by CORS, e.g.
#   https://your-frontend.example.com,https://www.your-frontend.example.com
# Unset or "*" allows any origin (fine for local dev). Pin this in production.
CORS_ORIGIN=*

# Max accepted JSON request body size (profile photos are inlined as data URLs).
# Defaults to "1mb".
JSON_BODY_LIMIT=1mb
