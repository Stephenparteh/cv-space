# Render (and any host that sets NODE_ENV=production) makes `npm install` /
# `npm ci` omit devDependencies. This project is COMPILED on the host
# (`npm run build` -> `tsc`), so the build needs `typescript` and the
# `@types/*` packages, which live in devDependencies.
#
# `include=dev` forces devDependencies to be installed regardless of NODE_ENV.
# npm resolves include over omit, so this also wins over an explicit
# `--omit=dev` / `NODE_ENV=production`.
include=dev
